# NVIDIA NIM (all AI matching uses this endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_TIMEOUT=60

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Legacy compatibility; TELEGRAM_BOT_TOKEN is preferred.
TELEGRAM_TOKEN=

# Optional job-source credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
FINDWORK_TOKEN=
MUSE_API_KEY=

# Optional local configuration
JOBS_DB_PATH=data/jobs.db
SCRAPE_INTERVAL_HOURS=3
MIN_MATCH_SCORE=80
AI_MAX_JOBS_PER_RUN=200
